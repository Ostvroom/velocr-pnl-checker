# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# X (Twitter) Configuration (Twikit - No API keys required!)
# Twikit works without any API credentials
# X_BOT_USERNAME and X_BOT_PASSWORD are only needed for posting

# X Bot Account (for posting)
X_BOT_USERNAME=your_bot_x_username
X_BOT_PASSWORD=your_bot_x_password

# Gemini API (for image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Image Generation
TEMPLATE_PATH=./templates/banner-template.png
OUTPUT_PATH=./output/

# Alchemy API Key (free at https://dashboard.alchemy.com)
# Required for automatic NFT PnL card generation
ALCHEMY_API_KEY=your_alchemy_api_key_here

# OpenSea API Key (OPTIONAL) — improves floor-price accuracy and covers Blur-only
# collections. If left blank, the bot auto-generates a free 30-day key on demand.
# Get a permanent key at https://opensea.io/settings/developer
OPENSEA_API_KEY=

# PnL Card Defaults
PNL_DEFAULT_CURRENCY=ETH
PNL_DEFAULT_TYPE=nft

# Bot Settings
BOT_PREFIX=!
BOT_NAME=X Banner Generator