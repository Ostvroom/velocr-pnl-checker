# Copy this file to `.env` in the SAME folder (next to pyproject.toml).
# Velcor loads only `.env`, not this example file.
# Use the Web3 Data API key from Moralis Admin → your project → Web3 API (JWT-style key).

MORALIS_API_KEY=
# Optional alias (same value):
# MORALIS_WEB3_API_KEY=

# Comma-separated 0x wallets for the public /api/feed (Kolscan-style ticker)
# VELOCR_FEED_WALLETS=0xabc...,0xdef...

# Optional: limit Moralis window (saves compute units)
# PNL_MORALIS_DAYS=90
# PNL_MORALIS_FROM_DATE=
# PNL_MORALIS_TO_DATE=
# PNL_MORALIS_FROM_BLOCK=
# PNL_MORALIS_TO_BLOCK=

# Pagination (defaults tuned for lower CU — raise only if you need full history)
# PNL_MORALIS_PAGE_LIMIT=100
# PNL_MORALIS_MAX_PAGES=15
# VELOCR_TRANSFER_MAX_PAGES=15
# VELOCR_DASHBOARD_TRADE_PAGES=4
# VELOCR_DASHBOARD_ACTIVITY_PAGES=2
# VELOCR_UNREALIZED_NFT_PAGES=3

# Dashboard bundle cache (seconds). 0 = disabled. Repeats same wallet/range hit cache.
# VELOCR_API_CACHE_TTL_S=45

# Skip expensive calls (1 / true / yes / on)
# VELOCR_SKIP_UNREALIZED=0
# VELOCR_SKIP_TRADE_NFT_ENRICH=0

# Trade list: max per-token Moralis lookups; collection logos still applied
# VELOCR_TRADE_IMAGE_ENRICH_MAX=24
# VELOCR_TRADE_COLLECTION_LOGO_MAX=28
# VELOCR_MORALIS_ENRICH_CONCURRENCY=6

# Collection metadata cache TTL (seconds)
# VELOCR_COLLECTION_META_TTL_S=600
