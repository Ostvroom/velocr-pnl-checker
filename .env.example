# Velcor PNL — Configuration

# --- Alchemy API (required for dashboard PnL / indexer) ---
# Create an app → Ethereum Mainnet → copy API key: https://dashboard.alchemy.com
# The dashboard uses: NFT API (getNFTSales, getNFTs, getFloorPrice) + RPC (alchemy_getAssetTransfers).
ALCHEMY_API_KEY=

# --- SimpleHash (Optional Fallback / Historical) ---
# SimpleHash is currently less preferred due to stability, but supported if ALCHEMY_API_KEY is missing.
SIMPLEHASH_API_KEY=

# --- Moralis (Legacy) ---
MORALIS_API_KEY=

# --- Access gate (landing + API locked until valid clearance key) ---
# Set GATE_SECRET to a long random string (e.g. openssl rand -hex 32).
# ACCESS_GATE_ENABLED=0  # disable gate (local dev)
GATE_SECRET=

# --- Indexer Settings (speed vs freshness) ---
# VELOCR_SYNC_STALE_S=1800   # Re-fetch from Alchemy if local cache older than this (seconds). Default 1800 = 30 min. Raise to 3600 (1h) for faster repeat loads.
# VELOCR_INDEX_MAX_PAGES=15  # Max Alchemy pages per direction (sales + NFT transfers + payment). Lower = faster but less history (1–50).
# VELOCR_INDEX_PAGE_DELAY_S=0.03  # Pause between paginated requests (seconds). 0 = fastest (may hit rate limits on some keys).

# --- Wallet Feed ---
# Comma-separated 0x wallets for the public /api/feed
VELOCR_FEED_WALLETS=

# --- Dashboard Settings ---
# VELOCR_SKIP_UNREALIZED=0
# VELOCR_SKIP_TRADE_NFT_ENRICH=0
